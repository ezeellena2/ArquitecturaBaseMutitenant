{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ArquitecturaBaseMultitenant.Application.Services.Messaging.OutboxDispatchService": "Warning",
      "ArquitecturaBaseMultitenant.Application.Services.Auth.AccountRecoveryNoticeService": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WhatsApp": {
    "GraphApiVersion": "v25.0",
    "Templates": {
      "LoginCode": "codigo_ingreso",
      "Invitation": "invitacion_organizacion",
      "LoginMethodChanged": "aviso_metodo_ingreso",
      "ReviewLoginMethods": "revisa_metodos_ingreso",
      "DeletionRequested": "baja_cuenta_pedida",
      "DeletionCancelled": "baja_cuenta_cancelada",
      "AccountDeleted": "cuenta_eliminada",
      "DeletionRequestedByPlatform": "baja_cuenta_plataforma",
      "DeletionRequestedSuspended": "baja_cuenta_plataforma_suspendida",
      "RecoveryReceived": "recuperacion_recibida",
      "RecoveryApproved": "recuperacion_aprobada",
      "RecoveryRejected": "recuperacion_rechazada",
      "RecoveryRequested": "recuperacion_aviso_cuenta",
      "OrganizationApproved": "organizacion_aprobada",
      "OrganizationRejected": "organizacion_rechazada",
      "PublicPageModerated": "pagina_publica_moderada"
    },
    "AllowedCountries": [ "AR" ],
    "DailyAuthCodeLimit": 100,
    "MessageRetentionDays": 90
  },
  "Email": {
    "AppName": "Arquitectura Base",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Security": "StartTls",
      "FromName": "Arquitectura Base"
    }
  },
  "RateLimiting": {
    "LoginCodePermitLimit": 20,
    "LoginCodeWindowMinutes": 15,
    "LoginVerifyPermitLimit": 30,
    "LoginVerifyWindowMinutes": 15,
    "InvitationPreviewPermitLimit": 60,
    "InvitationPreviewWindowMinutes": 15,
    "InvitationAcceptPermitLimit": 10,
    "InvitationAcceptWindowMinutes": 15
  }
}
