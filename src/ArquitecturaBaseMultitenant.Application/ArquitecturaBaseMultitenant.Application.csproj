<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Los .resx sin sufijo están en español. -->
    <NeutralLanguage>es</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArquitecturaBaseMultitenant.Domain\ArquitecturaBaseMultitenant.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <!-- ADR 0048: los tipos AI se usan únicamente dentro de Modules/Assistant. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR 0068 §12: la lista de acciones calificadas del asistente, vacía hasta calificarlas con un modelo real. -->
    <EmbeddedResource Include="Modules\Assistant\Actions\qualified-actions.json"
      LogicalName="ArquitecturaBaseMultitenant.Application.Modules.Assistant.Actions.qualified-actions.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArquitecturaBaseMultitenant.Application.UnitTests" />
    <!-- Los tests de integración emiten enlaces de ingreso con LoginLinkIssuer, sin pasar por el bot. -->
    <InternalsVisibleTo Include="ArquitecturaBaseMultitenant.Api.IntegrationTests" />
    <!-- El preparador emite invitaciones reales solo en la base E2E aislada. -->
    <InternalsVisibleTo Include="ArquitecturaBaseMultitenant.RealE2ESetup" />
  </ItemGroup>
</Project>
